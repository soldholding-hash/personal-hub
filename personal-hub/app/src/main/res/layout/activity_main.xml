<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="#0d0d1a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 Personal Hub"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#00d4ff"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Axes Productivité Congo"
        android:textSize="12sp"
        android:textColor="#556677"
        android:layout_marginBottom="32dp"/>

    <!-- Statut accès notifications -->
    <TextView
        android:id="@+id/tvNotifStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vérification…"
        android:textColor="#cccccc"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNotifAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activer l'accès aux notifications"
        android:backgroundTint="#00d4ff"
        android:textColor="#000000"
        android:layout_marginBottom="36dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e2a3a"
        android:layout_marginBottom="24dp"/>

    <!-- Statut général -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initialisation…"
        android:textColor="#889aaa"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Synchroniser maintenant"
        android:backgroundTint="#112233"
        android:textColor="#00d4ff"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync automatique toutes les 15 min (réseau requis)"
        android:textColor="#334455"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="10dp"/>

</LinearLayout>
